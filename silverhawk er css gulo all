/*INDEX HTML ER CSS*/
* {
    font-family: "Roboto", sans-serif;
    margin: 0;
    padding: 0;
}

.container {
    max-width: 1140px;
    padding: 0 10px;
    margin: 0 auto;
}


/* =========================================
   TOP HEADER SECTION
========================================= */

.top-header-section {
    background: #173a69;
    padding-top: 6px;
    padding-bottom: 6px;
}

.top-header-section a {
    color: #fff;
    text-decoration: none;
    font-size: 13px;
}

.top-header-section .main-column {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.top-header-section .right-column {
    display: flex;
    align-items: center;
    gap: 10px;
    text-align: right;
}

.top-header-section .fa-envelope {
    margin-left: 20px;
}

.top-header-section .fa-twitter {
    margin-left: 10px;
    margin-right: 10px;
}

.top-header-section .left-column i {
    margin-right: 5px;
}


/* =========================================
   MAIN HEADER / NAVIGATION
========================================= */

.header-section {
    background: #fff;
}

.header-section a {
    text-decoration: none;
    font-size: 15px;
    font-weight: 600;
    text-transform: uppercase;
    color: #000;
    position: relative;
    background: transparent;
}

.header-section .main-column {
    display: grid;
    grid-template-columns: 1fr 6fr;
    align-items: center;
}

.header-section .right-column {
    text-align: right;
}

.header-section ul {
    margin: 0;
    padding: 0;
}

.header-section li {
    list-style: none;
    display: inline-block;
    margin-right: 45px;
    padding: 0;
    transition: 0.4s;
}

.header-section li:last-child {
    margin-right: 0;
}


/* Navigation Link */

.header-section .right-column li a {
    display: inline-block;
    position: relative;
    z-index: 1;
    padding: 35px 20px 38px;
}


/* Grey Hover Background */

.header-section .right-column li a::before {
    content: "";
    position: absolute;

    top: 0;
    left: 50%;

    width: 100%;
    height: 100%;

    background-color: #f2f2f2;

    border-bottom: 3px solid #000;

    transform: translateX(-50%) scaleX(0);

    transition: transform 0.3s ease;

    z-index: -1;
}


/* Hover */

.header-section .right-column li a:hover::before {
    transform: translateX(-50%) scaleX(1);
}


/* =========================================
   BANNER SECTION
========================================= */

.section-banner .slider {
    position: relative;
    height: 460px;
    overflow: hidden;
}

.section-banner .slider > img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    margin: 0;
}

.section-banner .slider h3,
.section-banner .slider h1,
.section-banner .slider p {
    position: relative;
    left: 62%;
    width: 34%;
    box-sizing: border-box;
}

.section-banner .slider h3 {
    padding-top: 135px;
    font-size: 17px;
    color: #010101;
    font-weight: 900;
    text-transform: uppercase;
}

.section-banner .slider h1 {
    font-size: 60px;
    line-height: 1.1;
    color: #010101;
    font-weight: 900;
    text-transform: uppercase;
    margin-bottom: 5px;
}

.section-banner .slider p {
    font-size: 14px;
    line-height: 1.5;
    color: #010101;
    margin-bottom: 0;
}

.section-banner .slider a {
    position: relative;
    left: 62%;
    font-size: 14px;
    text-decoration: none;
    border: 2px solid #173a69;
    background: #173a69;
    color: #fff;
    font-weight: 700;
    text-transform: uppercase;
    padding: 9px 18px;
    display: inline-block;
    margin-top: 20px;
    width: auto;
    box-sizing: border-box;
}

.section-banner .slider a:last-child {
    background: #fff;
    color: #173a69;
    border: 1px solid #173a69;
    margin-left: 5px;
}

@media (max-width: 600px) {
    .section-banner .slider {
        height: 350px;
    }

    .section-banner .slider h3 {
        padding-top: 100px;
        font-size: 11px;
    }

    .section-banner .slider h1 {
        font-size: 28px;
    }

    .section-banner .slider h3,
    .section-banner .slider h1,
    .section-banner .slider p {
        left: 48%;
        width: 49%;
    }

    .section-banner .slider a {
        left: 48%;
        padding: 8px;
        font-size: 10px;
    }
}

/* Get Started Button */

.slider-caption a:last-child {
    background: #fff;
    color: #173a69;
    border: 1px solid #173a69;
    margin-left: 10px;
}


/* =========================================
   SERVICES SECTION
========================================= */

.service-section {
    text-align: center;
    padding-top: 90px;
    padding-bottom: 90px;
}

.service-section h2 {
    font-size: 28px;
    font-weight: 700;
    text-transform: uppercase;
    padding-bottom: 15px;
}

.service-section .main-column {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    align-items: center;
}


/* =========================================
   ABOUT US SECTION
========================================= */

.about-section {
    background: #f7f7f7;
    padding-top: 90px;
    padding-bottom: 90px;
}

.about-section h2 {
    margin-left: -350px;
}

/* Two Column Layout */

.about-main-column {
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: 70px;
    align-items: center;
}


/* =========================================
   ABOUT IMAGE
========================================= */

.about-left-column {
    position: relative;
    padding: 25px;
}

.about-image-box {
    position: relative;
    width: 100%;
}


/*
   IMPORTANT:
   No .about-dotted-box here.

   The dotted design is already inside
   math.png, so we don't create another one.
*/

.about-image-box img {
    position: relative;

    display: block;

    width: 100%;
    height: auto;
}


/* =========================================
   ABOUT CONTENT
========================================= */

.about-right-column {
    padding-left: 0;
}

.about-right-column h2 {
    font-size: 32px;
    font-weight: 800;
    color: #111;
    text-transform: uppercase;
    margin-bottom: 25px;
}


/* =========================================
   BLUE DIAMOND + LINE
========================================= */

.about-title-line {
    display: flex;
    align-items: center;
    margin-bottom: 30px;
}

.about-title-line .diamond {
    width: 18px;
    height: 18px;

    background: #173a69;

    transform: rotate(45deg);

    margin-right: 12px;
}

.about-title-line .line {
    width: 120px;
    height: 2px;

    background: #173a69;
}


/* =========================================
   ABOUT PARAGRAPHS
========================================= */

.about-right-column p {
    font-size: 16px;
    line-height: 1.8;
    color: #333;
    margin-bottom: 30px;
}


/* =========================================
   GENERAL H2
========================================= */

h2 {
    text-align: center;
    padding-top: 75px;
}


/* =========================================
   GENERAL IMAGES
========================================= */

img {
    display: block;
    margin-left: auto;
    margin-right: auto;
}


/* =========================================
   GALLERY SECTION
========================================= */

.Gallery-section {
    padding-top: 90px;
    padding-bottom: 90px;
    text-align: center;
}


/* Gallery Heading */

.Gallery-section h2 {
    text-align: center;
    padding-top: 0;
    margin-bottom: 15px;
}


/* Gallery Line */

.Gallery-section .gallery-line {
    display: block;
    margin-left: auto;
    margin-right: auto;
    margin-bottom: 40px;
}


/* Gallery Grid */

.Gallery-section .gallery {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 25px;

    /* Keep images close to the container borders */
    padding: 0;
    margin: 0;
}


/* Gallery Columns */

.Gallery-section .gallery .flex-column {
    width: 100%;
    margin: 0;
    padding: 0;
    overflow: hidden;
}


/* Gallery Images */

.Gallery-section .gallery .flex-column > img {
    width: 100%;
    height: 240px;
    object-fit: cover;
    display: block;
    margin: 0;
}

.Gallery-section a{
    font-size: 14px;
    text-decoration: none;
    border: 2px solid #173a69;
    background: #173a69;
    color: #fff;
    font-weight: 700;
    text-transform: uppercase;
    padding: 9px 18px;
    display: inline-block;
    margin-top: 30px;
}

.Gallery-section .caption img{
    width: auto;
    margin: 0 auto;
}

.Gallery-section .flex-column{
    position: relative;
    overflow: hidden;
}

.Gallery-section .flex-column:after{
    content: '';
    position:absolute;
    width:100%;
    height:100%;
    background:#000;
    top: 0;
    left: 0;
    opacity:0;
    transition: 0.4s ease;
}

.Gallery-section .flex-column:hover::after{
    opacity:0.6;
}

.Gallery-section .caption{
    position:absolute;
    top:50%;
    left:50%;
    transform:translate(-50%,-50%);
    text-align:center;
    opacity:0;
    transition:0.4s ease;
    z-index: 2;
}

.Gallery-section .caption h3{
    color:#fff;
}

.Gallery-section .flex-column:hover .caption {
    opacity: 1;
}




