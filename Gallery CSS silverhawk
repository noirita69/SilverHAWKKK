* {
    font-family: "Roboto", sans-serif;
    margin: 0;
    padding: 0;
}

.container {
    max-width: 1140px;
    padding: 0 10px;
    margin: 0 auto;
}


/* =========================================
   TOP HEADER SECTION
========================================= */

.top-header-section {
    background: #173a69;
    padding-top: 6px;
    padding-bottom: 6px;
}

.top-header-section a {
    color: #fff;
    text-decoration: none;
    font-size: 13px;
}

.top-header-section .main-column {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.top-header-section .right-column {
    display: flex;
    align-items: center;
    gap: 10px;
    text-align: right;
}

.top-header-section .fa-envelope {
    margin-left: 20px;
}

.top-header-section .fa-twitter {
    margin-left: 10px;
    margin-right: 10px;
}

.top-header-section .left-column i {
    margin-right: 5px;
}


/* =========================================
   MAIN HEADER / NAVIGATION
========================================= */

.header-section {
    background: #fff;
}

.header-section a {
    text-decoration: none;
    font-size: 15px;
    font-weight: 600;
    text-transform: uppercase;
    color: #000;
    position: relative;
    background: transparent;
}

.header-section .main-column {
    display: grid;
    grid-template-columns: 1fr 6fr;
    align-items: center;
}

.header-section .right-column {
    text-align: right;
}

.header-section ul {
    margin: 0;
    padding: 0;
}

.header-section li {
    list-style: none;
    display: inline-block;
    margin-right: 45px;
    padding: 0;
    transition: 0.4s;
}

.header-section li:last-child {
    margin-right: 0;
}


/* Navigation Link */

.header-section .right-column li a {
    display: inline-block;
    position: relative;
    z-index: 1;
    padding: 35px 20px 38px;
}


/* Grey Hover Background */

.header-section .right-column li a::before {
    content: "";
    position: absolute;

    top: 0;
    left: 50%;

    width: 100%;
    height: 100%;

    background-color: #f2f2f2;

    border-bottom: 3px solid #000;

    transform: translateX(-50%) scaleX(0);

    transition: transform 0.3s ease;

    z-index: -1;
}


/* Hover */

.header-section .right-column li a:hover::before {
    transform: translateX(-50%) scaleX(1);
}

.inner-banner{
    background:url(image/neww.png);
    background-repeat:no-repeat;
    background-size: cover;
    padding-top:60px;
    padding-bottom: 140px;
    text-align:center;
}

/* =========================================
   GALLERY SECTION
========================================= */

.Gallery-section {
    padding-top: 90px;
    padding-bottom: 90px;
    text-align: center;
}


/* Gallery Heading */

.Gallery-section h2 {
    text-align: center;
    padding-top: 0;
    margin-bottom: 15px;
}


/* Gallery Line */

.Gallery-section .gallery-line {
    display: block;
    margin-left: auto;
    margin-right: auto;
    margin-bottom: 40px;
}


/* Gallery Grid */

.Gallery-section .gallery {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 25px;

    /* Keep images close to the container borders */
    padding: 0;
    margin: 0;
}


/* Gallery Columns */

.Gallery-section .gallery .flex-column {
    width: 100%;
    margin: 0;
    padding: 0;
    overflow: hidden;
}


/* Gallery Images */

.Gallery-section .gallery .flex-column > img {
    width: 100%;
    height: 240px;
    object-fit: cover;
    display: block;
    margin: 0;
}

.Gallery-section a{
    font-size: 14px;
    text-decoration: none;
    border: 2px solid #173a69;
    background: #173a69;
    color: #fff;
    font-weight: 700;
    text-transform: uppercase;
    padding: 9px 18px;
    display: inline-block;
    margin-top: 30px;
}

.Gallery-section .caption img{
    width: auto;
    margin: 0 auto;
}

.Gallery-section .flex-column{
    position: relative;
    overflow: hidden;
}

.Gallery-section .flex-column:after{
    content: '';
    position:absolute;
    width:100%;
    height:100%;
    background:#000;
    top: 0;
    left: 0;
    opacity:0;
    transition: 0.4s ease;
}

.Gallery-section .flex-column:hover::after{
    opacity:0.6;
}

.Gallery-section .caption{
    position:absolute;
    top:50%;
    left:50%;
    transform:translate(-50%,-50%);
    text-align:center;
    opacity:0;
    transition:0.4s ease;
    z-index: 2;
}

.Gallery-section .caption h3{
    color:#fff;
}

.Gallery-section .flex-column:hover .caption {
    opacity: 1;
}




