* {
    font-family: "Roboto", sans-serif;
    margin: 0;
    padding: 0;
}

.container {
    max-width: 1140px;
    padding: 0 10px;
    margin: 0 auto;
}


/* =========================================
   TOP HEADER SECTION
========================================= */

.top-header-section {
    background: #173a69;
    padding-top: 6px;
    padding-bottom: 6px;
}

.top-header-section a {
    color: #fff;
    text-decoration: none;
    font-size: 13px;
}

.top-header-section .main-column {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.top-header-section .right-column {
    display: flex;
    align-items: center;
    gap: 10px;
    text-align: right;
}

.top-header-section .fa-envelope {
    margin-left: 20px;
}

.top-header-section .fa-twitter {
    margin-left: 10px;
    margin-right: 10px;
}

.top-header-section .left-column i {
    margin-right: 5px;
}


/* =========================================
   MAIN HEADER / NAVIGATION
========================================= */

.header-section {
    background: #fff;
}

.header-section a {
    text-decoration: none;
    font-size: 15px;
    font-weight: 600;
    text-transform: uppercase;
    color: #000;
    position: relative;
    background: transparent;
}

.header-section .main-column {
    display: grid;
    grid-template-columns: 1fr 6fr;
    align-items: center;
}

.header-section .right-column {
    text-align: right;
}

.header-section ul {
    margin: 0;
    padding: 0;
}

.header-section li {
    list-style: none;
    display: inline-block;
    margin-right: 45px;
    padding: 0;
    transition: 0.4s;
}

.header-section li:last-child {
    margin-right: 0;
}


/* Navigation Link */

.header-section .right-column li a {
    display: inline-block;
    position: relative;
    z-index: 1;
    padding: 35px 20px 38px;
}


/* Grey Hover Background */

.header-section .right-column li a::before {
    content: "";
    position: absolute;

    top: 0;
    left: 50%;

    width: 100%;
    height: 100%;

    background-color: #f2f2f2;

    border-bottom: 3px solid #000;

    transform: translateX(-50%) scaleX(0);

    transition: transform 0.3s ease;

    z-index: -1;
}


/* Hover */

.header-section .right-column li a:hover::before {
    transform: translateX(-50%) scaleX(1);
}

.inner-banner{
    background:url(image/neww.png);
    background-repeat:no-repeat;
    background-size: cover;
    padding-top:60px;
    padding-bottom: 140px;
    text-align:center;
}

/*CONTACT US*/

/* Contact Service Section */

.contact-service {
padding-top: 80px;
padding-bottom: 80px;
}

.contact-service .contact-main-column {
display: grid;
grid-template-columns: 3fr 1fr;
column-gap: 60px;
}

/* Left Column - Contact Form */

.contact-service .contact-form-column h2 {
padding-top: 40px;
padding-bottom: 10px;
font-size: 25px;
font-weight: 500;
}

.contact-service .contact-form-column p {
padding-top: 10px;
padding-bottom: 30px;
font-size: 16px;
font-weight: 500;
}

.contact-service .form-row {
display: grid;
grid-template-columns: 1fr 1fr;
column-gap: 30px;
}

.contact-service .contact-form input[type="text"],
.contact-service .contact-form input[type="email"] {
width: 100%;
margin-bottom: 25px;
padding: 10px;
border: 1px solid #e1e1e1;
box-sizing: border-box;
}

.contact-service .contact-form textarea {
width: 100%;
resize: none;
height: 170px;
padding: 10px;
border: 1px solid #e1e1e1;
box-sizing: border-box;
}

.contact-service .contact-form .SubmitButton {
width: auto;
background: #173a69;
color: #fff;
font-size: 16px;
font-weight: 300;
padding: 11px 33px;
margin-top: 20px;
margin-bottom: 50px;
cursor: pointer;
border: none;
}

/* Right Column - Company Information */

.contact-service .contact-info-column h2 {
padding-top: 40px;
padding-bottom: 20px;
font-size: 25px;
font-weight: 700;
}

.contact-service .contact-info-column ul {
line-height: 35px;
padding-left: 0;
list-style: none;
}

.contact-service .contact-info-column li {
list-style: none;
font-weight: 800;
color: #173a69;
padding-bottom: 10px;
}

.contact-service .contact-info-column li i {
margin-right: 8px;
}

.contact-service .contact-info-column a {
text-decoration: none;
font-weight: 400;
color: #000;
}

.contact-service .contact-info-column a {
color: #173a69;
}

.get-started{
